# Redis
REDIS_URL=redis://localhost:6379/0

# Collector
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=4318
OTEL_SERVICE_NAME=orchestraos-collector

# Google Pub/Sub (local emulator)
PUBSUB_EMULATOR_HOST=localhost:8085
GOOGLE_CLOUD_PROJECT=orchestraos-local
PUBSUB_TOPIC_RAW_SPANS=raw-spans
PUBSUB_TOPIC_FEATURE_VECTORS=feature-vectors
PUBSUB_TOPIC_RISK_ASSESSMENTS=risk-assessments
PUBSUB_SUBSCRIPTION_RAW_SPANS=raw-spans-sub
PUBSUB_SUBSCRIPTION_FEATURE_VECTORS=feature-vectors-sub

# Gemini (local dev — production uses Secret Manager)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PUBSUB_SUBSCRIPTION_FEATURE_VECTORS=feature-vectors-sub
PUBSUB_SUBSCRIPTION_RISK_ASSESSMENTS=risk-assessments-sub
PUBSUB_TOPIC_BREAKER_EVENTS=breaker-events
PUBSUB_TOPIC_REMEDIATION_PLANS=remediation-plans
PUBSUB_SUBSCRIPTION_BREAKER_EVENTS=breaker-events-sub
PUBSUB_SUBSCRIPTION_REMEDIATION_PLANS=remediation-plans-sub
PUBSUB_SUBSCRIPTION_PARTNERS_BREAKER=partners-breaker-sub
PUBSUB_SUBSCRIPTION_PARTNERS_REMEDIATION=partners-remediation-sub

# Circuit breaker
BREAKER_RISK_THRESHOLD=0.8
BREAKER_COOLDOWN_SEC=30
BREAKER_HALF_OPEN_MAX_CALLS=3

# GCP production (Secret Manager — do not commit real values)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Partner integrations (Phase 8) — set PARTNER_<NAME>_ENABLED=true to activate
# PARTNER_ARIZE_ENABLED=false
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PARTNER_MONGODB_ENABLED=false
# MONGODB_URI=mongodb://localhost:27017
# PARTNER_ELASTIC_ENABLED=false
# ELASTIC_URL=http://localhost:9200
# ELASTIC_API_KEY=
# PARTNER_DYNATRACE_ENABLED=false
# DYNATRACE_URL=https://your-env.live.dynatrace.com
# DYNATRACE_API_TOKEN=
# PARTNER_GITLAB_ENABLED=false
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=
# GITLAB_PROJECT_ID=
